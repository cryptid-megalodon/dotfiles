#!/bin/sh
# Runs once per machine, before any files are written.
# Installs the bare minimum needed for the rest of the scripts to work.
set -eu

{{ if eq .chezmoi.os "darwin" -}}
if ! xcode-select -p >/dev/null 2>&1; then
    echo "==> Installing Xcode Command Line Tools"
    xcode-select --install
    echo "Re-run 'chezmoi apply' once the install finishes."
    exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "==> Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{ else if eq .chezmoi.os "linux" -}}
echo "==> Installing base dependencies"
sudo apt-get update
sudo apt-get install -y build-essential curl git zsh
{{ end -}}
