#!/bin/sh
# chezmoi owns only these keys; tools like `claude plugin install` manage the
# rest of the file (enabledPlugins, extraKnownMarketplaces, ...).
input=$(cat)
printf "%s" "${input:-"{}"}" | jq '. * {
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "permissions": { "defaultMode": "auto" }
}
| .permissions.allow = ((.permissions.allow // []) + ["Bash(gh pr merge *)"] | unique)
| .hooks.PreToolUse = [(.hooks.PreToolUse // [])[]
    | select(any(.hooks[]?; (.command // "") | contains("pup-write-gate")) | not)]
| if .hooks.PreToolUse == [] then del(.hooks.PreToolUse) else . end
| if .hooks == {} then del(.hooks) else . end'
