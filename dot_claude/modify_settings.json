#!/bin/sh
# chezmoi owns only these keys; tools like `claude plugin install` manage the
# rest of the file (enabledPlugins, extraKnownMarketplaces, ...).
input=$(cat)
printf "%s" "${input:-"{}"}" | jq '. * {
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "permissions": { "defaultMode": "auto" }
}
| .permissions.allow = ((.permissions.allow // []) + ["Bash(gh pr merge *)"] | unique)
| .hooks.PreToolUse = ([(.hooks.PreToolUse // [])[]
    | select(any(.hooks[]?; .command == "~/.claude/hooks/pup-write-gate.py") | not)]
  + [{
    "matcher": "Bash",
    "hooks": [{
      "type": "command",
      "command": "~/.claude/hooks/pup-write-gate.py",
      "timeout": 30,
      "statusMessage": "Checking for Datadog writes..."
    }]
  }])'
