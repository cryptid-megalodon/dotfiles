# Ghostty — https://ghostty.org/docs/config
theme = Dracula
font-size = 12
window-padding-x = 8
window-padding-y = 8
cursor-style = block
shell-integration = zsh
copy-on-select = clipboard
confirm-close-surface = false
# Send Option as Alt (macOS only) so tmux M- bindings work.
macos-option-as-alt = true
# Global hotkey: open a new window from any app (needs Accessibility permission).
keybind = global:ctrl+cmd+t=new_window
# Ctrl+Shift+T opens a new tab on every OS. It's the Linux default; macOS only
# binds Cmd+T, which still works.
keybind = ctrl+shift+t=new_tab
# Ctrl+Shift+W runs the done-r skill: types /done-r + Enter into the focused
# pane (only press it with claude idle and its input empty). On Linux this
# replaces the default close_tab.
keybind = ctrl+shift+w=text:/done-r\r
# Ctrl+V pastes from the clipboard in zsh (default is Ctrl+Shift+V). Claude Code never sees
# Ctrl+V with this on, so its image paste breaks.
keybind = ctrl+v=paste_from_clipboard
